{
  "version": 1,
  "id": "functional-test",
  "name": "功能测试",
  "description": "从用户和系统边界验证完整功能、跨模块交互和验收条件。",
  "paths": {
    "read": [
      "/docs/demand",
      "/docs/design",
      "/docs/test",
      "/code",
      "/data",
      "/command",
      "/deploy/env",
      "/status"
    ],
    "write": [
      "/docs/test",
      "/docs/bug",
      "/status"
    ]
  },
  "safety": {
    "inherits": "/deploy/safe.json",
    "precedence": "conversation-user-rules > project-general-rules > step-rules",
    "riskLevel": "high"
  }
}
