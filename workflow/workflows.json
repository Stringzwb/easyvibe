{
  "version": 1,
  "workflows": [
    {
      "id": "fullstack-feature",
      "name": "全栈功能开发",
      "description": "从需求、调研和 UI 设计到开发、测试、打包与部署的完整流程。",
      "entry": "project-information",
      "nodes": [
        {
          "id": "project-information",
          "step": "project-info-approval"
        },
        {
          "id": "requirements",
          "step": "demand-design"
        },
        {
          "id": "research",
          "step": "research"
        },
        {
          "id": "ui",
          "step": "ui-design"
        },
        {
          "id": "implementation",
          "step": "coding"
        },
        {
          "id": "unit-tests",
          "step": "unit-test"
        },
        {
          "id": "api-tests",
          "step": "api-test"
        },
        {
          "id": "functional-tests",
          "step": "functional-test"
        },
        {
          "id": "package",
          "step": "package"
        },
        {
          "id": "deploy",
          "step": "deploy"
        }
      ],
      "transitions": [
        {
          "from": "project-information",
          "to": "requirements",
          "when": "项目基本信息与命名规范已核准"
        },
        {
          "from": "requirements",
          "to": "research"
        },
        {
          "from": "research",
          "to": "ui"
        },
        {
          "from": "ui",
          "to": "implementation"
        },
        {
          "from": "implementation",
          "to": "unit-tests"
        },
        {
          "from": "unit-tests",
          "to": "api-tests",
          "when": "单元测试通过"
        },
        {
          "from": "unit-tests",
          "to": "implementation",
          "when": "单元测试失败"
        },
        {
          "from": "api-tests",
          "to": "functional-tests",
          "when": "API 测试通过"
        },
        {
          "from": "api-tests",
          "to": "implementation",
          "when": "API 问题需要修复"
        },
        {
          "from": "functional-tests",
          "to": "package",
          "when": "功能测试通过"
        },
        {
          "from": "functional-tests",
          "to": "implementation",
          "when": "功能测试失败"
        },
        {
          "from": "package",
          "to": "deploy",
          "when": "用户确认部署"
        }
      ]
    },
